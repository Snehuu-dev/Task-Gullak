{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "admin/index.html", "use": "@vercel/static" },
    { "src": "admin.html", "use": "@vercel/static" },
    { "src": "privacy.html", "use": "@vercel/static" },
    { "src": "delete.html", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "admin-panel/**", "use": "@vercel/static" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/delete-account", "dest": "/delete.html" },
    { "src": "/delete.acc", "dest": "/delete.html" },
    { "src": "/delete", "dest": "/delete.html" },
    { "src": "/admin-panel(.*)", "dest": "/admin/index.html" },
    { "src": "/admin(.*)", "dest": "/admin/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
