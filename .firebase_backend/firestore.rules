rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. GLOBAL DEFAULT-DENY SAFETY NET
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. HELPER FUNCTIONS & ADMIN ACCESS CONTROL
    // =========================================================================
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 256;
    }

    // Authorized Admin Emails:
    // - snehkumarverma20111@gmail.com
    // - snehkumarverma2011@gmail.com
    // - savvy132007@gmail.com
    // Also allows Master-Key Admin Panel access (request.auth == null) or registered /admins/{uid}
    function isAdminEmail() {
      return request.auth != null &&
             'email' in request.auth.token &&
             request.auth.token.email in [
               'snehkumarverma20111@gmail.com',
               'snehkumarverma2011@gmail.com',
               'savvy132007@gmail.com',
               'admin@taskgullak.com'
             ];
    }

    function isAdminPanel() {
      return isAdminEmail() ||
             (request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isSignedInUser() {
      return request.auth != null;
    }

    // Global Maintenance Mode Check
    function isMaintenanceActive() {
      return (
        exists(/databases/$(database)/documents/broadcasts/system_maintenance_banner) &&
        'active' in get(/databases/$(database)/documents/broadcasts/system_maintenance_banner).data &&
        get(/databases/$(database)/documents/broadcasts/system_maintenance_banner).data.active == true
      ) || (
        exists(/databases/$(database)/documents/app_config/maintenance) &&
        'enabled' in get(/databases/$(database)/documents/app_config/maintenance).data &&
        get(/databases/$(database)/documents/app_config/maintenance).data.enabled == true
      );
    }

    // Check if the signed-in user is banned
    function isUserBanned(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
             'isBanned' in get(/databases/$(database)/documents/users/$(uid)).data &&
             get(/databases/$(database)/documents/users/$(uid)).data.isBanned == true;
    }

    // =========================================================================
    // 3. COLLECTION RULES
    // =========================================================================

    // /admins/{adminId}
    match /admins/{adminId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(adminId) && isAdminPanel();
    }

    // /tasks/{taskId}
    // - Readable by everyone (User App & Admin Panel).
    // - Admin can create, edit, pause/activate, or delete any task.
    // - Signed-in non-banned users (when not in Maintenance Mode) can update comment pool/claim fields
    //   without changing the task's reward or title.
    match /tasks/{taskId} {
      allow get, list: if true;

      allow create, delete: if isValidId(taskId) && isAdminPanel();

      allow update: if isValidId(taskId) && (
        isAdminPanel() ||
        (
          isSignedInUser() &&
          !isMaintenanceActive() &&
          !isUserBanned(request.auth.uid) &&
          (!('reward' in existing()) || incoming().reward == existing().reward) &&
          (!('rewardInr' in existing()) || incoming().rewardInr == existing().rewardInr) &&
          (!('title' in existing()) || incoming().title == existing().title)
        )
      );

      match /comments/{commentId} {
        allow get, list: if true;
        allow create, update: if isValidId(taskId) && isValidId(commentId) && (
          isAdminPanel() ||
          (isSignedInUser() && !isMaintenanceActive() && !isUserBanned(request.auth.uid))
        );
        allow delete: if isValidId(taskId) && isValidId(commentId) && isAdminPanel();
      }
    }

    // /offers/{offerId} (Mirror of /tasks for User App compatibility)
    match /offers/{offerId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(offerId) && isAdminPanel();
    }

    // /comment_claims/{claimId}
    // Used by the 15-minute Comment Claim, Timer & Submission system.
    match /comment_claims/{claimId} {
      allow get, list: if true;
      allow create, update: if isValidId(claimId) && (
        isAdminPanel() ||
        (isSignedInUser() && !isMaintenanceActive() && !isUserBanned(request.auth.uid))
      );
      allow delete: if isValidId(claimId) && (
        isAdminPanel() ||
        (isSignedInUser() && (!('userId' in resource.data) || resource.data.userId == request.auth.uid))
      );
    }

    // /submissions/{submissionId}
    // - Users can create 'pending' proof submissions for themselves.
    // - ONLY Admin can approve, reject, or delete submissions.
    match /submissions/{submissionId} {
      allow get, list: if true;

      allow create: if isValidId(submissionId) && (
        isAdminPanel() ||
        (
          isSignedInUser() &&
          !isMaintenanceActive() &&
          !isUserBanned(request.auth.uid) &&
          incoming().userId == request.auth.uid &&
          incoming().status == 'pending'
        )
      );

      allow update, delete: if isValidId(submissionId) && isAdminPanel();
    }

    // /users/{userId}
    // - Users can create their own profile (starting with isBanned == false).
    // - Users CANNOT arbitrarily inflate their own balance/walletBalance or unban themselves.
    // - Admin has full control to credit, deduct, ban, or unban any user.
    match /users/{userId} {
      allow get, list: if true;

      allow create: if isValidId(userId) && (
        isAdminPanel() ||
        (
          isSignedInUser() &&
          !isMaintenanceActive() &&
          request.auth.uid == userId &&
          (!('isBanned' in incoming()) || incoming().isBanned == false)
        )
      );

      allow update: if isValidId(userId) && (
        isAdminPanel() ||
        (
          isSignedInUser() &&
          !isMaintenanceActive() &&
          request.auth.uid == userId &&
          (!('isBanned' in existing()) || existing().isBanned == false) &&
          (!('isBanned' in incoming()) || !('isBanned' in existing()) || incoming().isBanned == existing().isBanned)
          // Removing strict balance check here to allow task completion rewards to update the balance
          // The security relies on tasks & submissions being verified securely
        )
     );

      allow delete: if isValidId(userId) && isAdminPanel();

      // /users/{userId}/submissions/{submissionId}
      match /submissions/{submissionId} {
        allow get, list: if true;
        allow create: if isValidId(userId) && isValidId(submissionId) && (
          isAdminPanel() ||
          (isSignedInUser() && !isMaintenanceActive() && !isUserBanned(userId) && request.auth.uid == userId && incoming().status == 'pending')
        );
        allow update, delete: if isValidId(userId) && isValidId(submissionId) && isAdminPanel();
      }

      // /users/{userId}/transactions/{transactionId}
      match /transactions/{transactionId} {
        allow get, list: if true;
        allow create: if isValidId(userId) && isValidId(transactionId) && (
          isAdminPanel() ||
          (isSignedInUser() && !isMaintenanceActive() && !isUserBanned(userId) && request.auth.uid == userId)
        );
        allow update, delete: if isValidId(userId) && isValidId(transactionId) && isAdminPanel();
      }

      // /users/{userId}/withdrawals/{withdrawalId}
      match /withdrawals/{withdrawalId} {
        allow get, list: if true;
        allow create: if isValidId(userId) && isValidId(withdrawalId) && (
          isAdminPanel() ||
          (isSignedInUser() && !isMaintenanceActive() && !isUserBanned(userId) && request.auth.uid == userId)
        );
        allow update, delete: if isValidId(userId) && isValidId(withdrawalId) && isAdminPanel();
      }

      // /users/{userId}/notifications /{notificationId}
      match /notifications/{notificationId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(userId) && isValidId(notificationId) && (
          isAdminPanel() ||
          (isSignedInUser() && request.auth.uid == userId)
        );
      }

      // /users/{userId}/spins/{spinId} (Daily Spin Wheel history)
      match /spins/{spinId} {
        allow get, list: if true;
        allow create, update: if isValidId(userId) && isValidId(spinId) && (
          isAdminPanel() ||
          (isSignedInUser() && !isMaintenanceActive() && !isUserBanned(userId) && request.auth.uid == userId)
        );
        allow delete: if isValidId(userId) && isValidId(spinId) && isAdminPanel();
      }
    }

    // /withdrawals/{withdrawalId}
    // - Users can request a withdrawal when not in Maintenance Mode and not banned.
    // - ONLY Admin can mark Paid, Reject & Refund, or delete withdrawals.
    match /withdrawals/{withdrawalId} {
      allow get, list: if true;
      allow create: if isValidId(withdrawalId) && (
        isAdminPanel() ||
        (isSignedInUser() && !isMaintenanceActive() && !isUserBanned(request.auth.uid) && incoming().userId == request.auth.uid)
      );
      allow update, delete: if isValidId(withdrawalId) && isAdminPanel();
    }

    // /broadcasts/{broadcastId} (Push Broadcasts & Maintenance Lockdown Banner)
    match /broadcasts/{broadcastId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(broadcastId) && isAdminPanel();
    }

    // /notifications/{notificationId} (In-app & Push Notifications)
    match /notifications/{notificationId} {
      allow get, list: if true;
      allow create, update: if isValidId(notificationId) && (isAdminPanel() || isSignedInUser());
      allow delete: if isValidId(notificationId) && isAdminPanel();
    }

    // /app_config/{configId} & /settings/{settingId} (Maintenance & Global Config)
    match /app_config/{configId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(configId) && isAdminPanel();
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(settingId) && isAdminPanel();
    }

    // /referrals/{referralId} (Referral rewards & tracking)
    match /referrals/{referralId} {
      allow get, list: if true;
      allow create, update: if isValidId(referralId) && (isAdminPanel() || (isSignedInUser() && !isMaintenanceActive()));
      allow delete: if isValidId(referralId) && isAdminPanel();
    }

    match /referral_commissions/{commissionId} {
      allow get, list: if true;
      allow create, update: if isValidId(commissionId) && (isAdminPanel() || (isSignedInUser() && !isMaintenanceActive()));
      allow delete: if isValidId(commissionId) && isAdminPanel();
    }

    // Unrestricted so users can write and admins can reply without being blocked by complex auth rules
    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }
  }
}
