rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin check: supports explicit /admins/{uid} document OR verified bootstrapped admin email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        ('email' in request.auth.token &&
         request.auth.token.email == 'snehkumarverma2011@gmail.com') ||
        request.auth.token.email == 'admin@taskgullak.com'
      );
    }

    function isValidAdminRole(data, adminId) {
      return data.keys().hasAll(['adminId', 'email', 'role', 'createdAt']) &&
             data.keys().hasOnly(['adminId', 'email', 'role', 'createdAt']) &&
             data.adminId is string &&
             data.adminId == adminId &&
             data.email is string &&
             data.email.size() >= 3 &&
             data.email.size() <= 150 &&
             data.role is string &&
             data.role in ['admin', 'super_admin'] &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
               'userId',
               'fullName',
               'email',
               'walletBalance',
               'completedTasksCount',
               'pendingRewards',
               'emailVerified',
               'createdAt',
               'updatedAt'
             ]) &&
              data.keys().hasOnly([
               'userId',
               'fullName',
               'email',
               'walletBalance',
               'completedTasksCount',
               'pendingRewards',
               'emailVerified',
               'isBanned',
               'banReason',
               'avatarId',
               'bannerId',
               'username',
               'bio',
               'upiId',
               'isDeleted',
               'accountStatus',
               'firstWithdrawalBonusClaimed',
               'maintenanceLocked',
               'referralCode',
               'referredByCode',
               'referredByUserId',
               'referralCommissionRatePercent',
               'referralCommissionEarned',
               'totalReferralBonusEarned',
               'totalLifetimeCommissionEarned',
               'lastCreditedCompletedTasksCount',
               'lastCompletedTaskReward',
               'dailyStreakDays',
               'lastStreakDate',
               'createdAt',
               'updatedAt'
             ]) &&
             data.userId is string &&
             data.userId == userId &&
             data.fullName is string &&
             data.fullName.size() >= 1 &&
             data.fullName.size() <= 100 &&
             data.email is string &&
             data.email.size() >= 3 &&
             data.email.size() <= 150 &&
             data.walletBalance is int &&
             data.walletBalance >= 0 &&
             data.walletBalance <= 10000000 &&
             data.completedTasksCount is int &&
             data.completedTasksCount >= 0 &&
             data.completedTasksCount <= 100000 &&
             data.pendingRewards is int &&
             data.pendingRewards >= 0 &&
             data.pendingRewards <= 10000000 &&
             data.emailVerified is bool &&
             (!('isBanned' in data) || data.isBanned is bool) &&
             (!('banReason' in data) || (data.banReason is string && data.banReason.size() <= 300)) &&
             (!('avatarId' in data) || (data.avatarId is string && data.avatarId.size() <= 64)) &&
             (!('bannerId' in data) || (data.bannerId is string && data.bannerId.size() <= 64)) &&
             (!('username' in data) || (data.username is string && data.username.size() <= 64)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
             (!('upiId' in data) || (data.upiId is string && data.upiId.size() <= 120)) &&
             (!('isDeleted' in data) || data.isDeleted is bool) &&
             (!('accountStatus' in data) || (data.accountStatus is string && data.accountStatus.size() <= 32)) &&
             (!('firstWithdrawalBonusClaimed' in data) || data.firstWithdrawalBonusClaimed is bool) &&
             (!('maintenanceLocked' in data) || data.maintenanceLocked is bool) &&
             (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 32)) &&
             (!('referredByCode' in data) || (data.referredByCode is string && data.referredByCode.size() <= 32)) &&
             (!('referredByUserId' in data) || (data.referredByUserId is string && data.referredByUserId.size() <= 128)) &&
             (!('referralCommissionRatePercent' in data) || (data.referralCommissionRatePercent is int && data.referralCommissionRatePercent >= 0 && data.referralCommissionRatePercent <= 100)) &&
             (!('referralCommissionEarned' in data) || (data.referralCommissionEarned is int && data.referralCommissionEarned <= 10000000)) &&
             (!('totalReferralBonusEarned' in data) || (data.totalReferralBonusEarned is int && data.totalReferralBonusEarned <= 10000000)) &&
             (!('totalLifetimeCommissionEarned' in data) || (data.totalLifetimeCommissionEarned is int && data.totalLifetimeCommissionEarned <= 10000000)) &&
             (!('lastCreditedCompletedTasksCount' in data) || (data.lastCreditedCompletedTasksCount is int && data.lastCreditedCompletedTasksCount >= 0 && data.lastCreditedCompletedTasksCount <= 100000)) &&
             (!('lastCompletedTaskReward' in data) || (data.lastCompletedTaskReward is int && data.lastCompletedTaskReward >= 0 && data.lastCompletedTaskReward <= 1000000)) &&
             (!('dailyStreakDays' in data) || (data.dailyStreakDays is int && data.dailyStreakDays >= 0 && data.dailyStreakDays <= 10000)) &&
             (!('lastStreakDate' in data) || (data.lastStreakDate is string && data.lastStreakDate.size() <= 32)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidTaskSubmission(data, userId) {
      return data.keys().hasAll([
               'userId',
               'taskId',
               'taskTitle',
               'category',
               'rewardAmount',
               'proofText',
               'status',
               'createdAt',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId',
               'taskId',
               'taskTitle',
               'category',
               'rewardAmount',
               'originalRewardAmount',
               'proofText',
               'status',
               'userName',
               'userEmail',
               'screenshotBase64',
               'adminNote',
               'aiVerified',
               'aiCompletionPercent',
               'aiVerdict',
               'aiSummary',
               'matchedTaskName',
               'createdAt',
               'updatedAt'
             ]) &&
             data.userId is string &&
             data.userId == userId &&
             data.taskId is string &&
             data.taskId.size() >= 1 &&
             data.taskId.size() <= 64 &&
             data.taskTitle is string &&
             data.taskTitle.size() >= 1 &&
             data.taskTitle.size() <= 120 &&
             data.category is string &&
             data.category.size() >= 1 &&
             data.category.size() <= 60 &&
             data.rewardAmount is int &&
             data.rewardAmount >= 0 &&
             data.rewardAmount <= 100000 &&
             (!('originalRewardAmount' in data) || (data.originalRewardAmount is int && data.originalRewardAmount >= 0 && data.originalRewardAmount <= 100000)) &&
             data.proofText is string &&
             data.proofText.size() >= 1 &&
             data.proofText.size() <= 2000 &&
             data.status is string &&
             data.status in ['pending', 'verified', 'approved', 'rejected'] &&
             (!('userName' in data) || (data.userName is string && data.userName.size() <= 100)) &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 150)) &&
             (!('screenshotBase64' in data) || (data.screenshotBase64 is string && data.screenshotBase64.size() <= 750000)) &&
             (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 1000)) &&
             (!('aiVerified' in data) || data.aiVerified is bool) &&
             (!('aiCompletionPercent' in data) || (data.aiCompletionPercent is int && data.aiCompletionPercent >= 0 && data.aiCompletionPercent <= 100)) &&
             (!('aiVerdict' in data) || (data.aiVerdict is string && data.aiVerdict.size() <= 100)) &&
             (!('aiSummary' in data) || (data.aiSummary is string && data.aiSummary.size() <= 1000)) &&
             (!('matchedTaskName' in data) || (data.matchedTaskName is string && data.matchedTaskName.size() <= 200)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidAdminTask(data) {
      return data.keys().size() >= 1 &&
             (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
             (!('appName' in data) || (data.appName is string && data.appName.size() <= 200));
    }

    // Validates a broadcast/push notification document
    function isValidBroadcast(data) {
      return data.keys().hasAll([
               'title',
               'message',
               'type',
               'active',
               'createdAt'
             ]) &&
             // Allow 'id', 'body', 'createdBy' which are sent from Admin Panel
             data.keys().hasOnly([
               'id',
               'title',
               'message',
               'body',
               'type',
               'targetUserId',
               'active',
               'createdBy',
               'createdAt',
               'updatedAt'
             ]) &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 140 &&
             data.message is string &&
             data.message.size() >= 1 &&
             data.message.size() <= 1000 &&
             data.type is string &&
             data.type in ['broadcast', 'offer', 'alert', 'new_task', 'reward_update', 'system'] &&
             (!('targetUserId' in data) || (data.targetUserId is string && data.targetUserId.size() >= 1 && data.targetUserId.size() <= 128)) &&
             data.active is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidWalletTransaction(data, userId) {
      return data.keys().hasAll([
               'userId',
               'amount',
               'type',
               'note',
               'createdAt'
             ]) &&
             data.keys().hasOnly([
               'userId',
               'amount',
               'type',
               'note',
               'status',
               'payoutMethod',
               'upiId',
               'withdrawalId',
               'createdAt',
               'updatedAt'
             ]) &&
             data.userId is string &&
             data.userId == userId &&
             data.amount is int &&
             data.amount >= 1 &&
             data.amount <= 10000000 &&
             data.type is string &&
             data.type in ['admin_credit', 'admin_deduct', 'task_reward', 'withdrawal', 'referral_commission', 'referral_bonus'] &&
             data.note is string &&
             data.note.size() >= 1 &&
             data.note.size() <= 300 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    match /app_config/{configId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() || request.auth == null;
    }

    match /admins/{adminId} {
      allow get, list: if true;
      allow create, update: if isValidId(adminId) && isValidAdminRole(incoming(), adminId);
      allow delete: if isValidId(adminId);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || request.auth == null;
      allow list: if isSignedIn() || isAdmin() || request.auth == null;

      allow create: if isValidId(userId) &&
                       (isOwner(userId) || isAdmin() || request.auth == null) &&
                       incoming().userId == userId &&
                       (!('isBanned' in incoming()) || incoming().isBanned == false || isAdmin() || request.auth == null) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isValidId(userId) &&
                       (
                         isOwner(userId) ||
                         isAdmin() ||
                         request.auth == null ||
                         (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['walletBalance', 'referralCommissionEarned', 'lastCreditedCompletedTasksCount', 'updatedAt']))
                       ) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(userId) && (isAdmin() || request.auth == null);

      match /submissions/{submissionId} {
        allow get, list: if isOwner(userId) || isAdmin() || request.auth == null || true;

        allow create: if isValidId(userId) &&
                         isValidId(submissionId) &&
                         (isOwner(userId) || isAdmin() || request.auth == null) &&
                         incoming().userId == userId &&
                         isValidTaskSubmission(incoming(), userId);

        allow update: if isValidId(userId) &&
                         isValidId(submissionId) &&
                         (isOwner(userId) || isAdmin() || request.auth == null) &&
                         isValidTaskSubmission(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().taskId == existing().taskId &&
                         incoming().createdAt == existing().createdAt;

        allow delete: if isValidId(userId) && isValidId(submissionId) && (isAdmin() || request.auth == null);
      }

      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId) || isAdmin() || request.auth == null;

        allow create: if isValidId(userId) &&
                         isValidId(transactionId) &&
                         isValidWalletTransaction(incoming(), userId);

        allow update, delete: if isValidId(userId) && isValidId(transactionId) && (isAdmin() || request.auth == null);
      }
    }

    match /referral_commissions/{commissionId} {
      allow get, list: if isSignedIn() || isAdmin() || request.auth == null;
      allow create, update: if isValidId(commissionId) && (isSignedIn() || isAdmin() || request.auth == null);
      allow delete: if isValidId(commissionId) && (isAdmin() || request.auth == null);
    }

    match /referrals/{referralId} {
      allow get, list: if isSignedIn() || isAdmin() || request.auth == null;
      allow create, update: if isValidId(referralId) && (isSignedIn() || isAdmin() || request.auth == null);
      allow delete: if isValidId(referralId) && (isAdmin() || request.auth == null);
    }

    // Unrestricted so users can write and admins can reply without being blocked by complex auth rules
    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }

    match /submissions/{submissionId} {
      allow get, list: if true;

      allow create: if isValidId(submissionId) &&
                       isValidTaskSubmission(incoming(), incoming().userId);

      allow update: if isValidId(submissionId);

      allow delete: if isValidId(submissionId);
    }

    match /tasks/{taskId} {
      allow get, list: if true;
      allow create, update: if isValidId(taskId) && isValidAdminTask(incoming());
      allow delete: if isValidId(taskId);
    }

    // Allows admin (or unauthenticated locally testing users) to create broadcast alerts
    match /broadcasts/{broadcastId} {
      allow get, list: if true;
      allow create: if isValidId(broadcastId) && (isAdmin() || request.auth == null) && isValidBroadcast(incoming());
      allow update: if isValidId(broadcastId) && (isAdmin() || request.auth == null) && isValidBroadcast(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(broadcastId) && (isAdmin() || request.auth == null);
    }

    match /app_config/{configId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(configId);
    }

    match /app_settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    match /withdrawals/{withdrawalId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(withdrawalId);
    }

    match /device_accounts/{deviceId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(deviceId);
    }
  }
}
